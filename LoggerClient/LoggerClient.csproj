<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <PackageId>SDDP-LoggerClientNet</PackageId>
        <Version>1.1.0</Version>
        <Authors>Osama Eshmilh, Nitish Kumar Gupta</Authors>
        <Description>ASP.NET Core middleware that logs HTTP requests and responses and publishes them to Apache Kafka using Confluent.Kafka, authenticated with an application token.</Description>
        <PackageTags>aspnetcore;middleware;http-logging;logging;logger;kafka;confluent;dotnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/osamaeshmilh/LoggerClientNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/osamaeshmilh/LoggerClientNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Fixed request body handling, stopped skipping the pipeline silently when authentication fails, added exception safety, redacted sensitive headers and cookies, and updated to .NET 8, 9, and 10.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>